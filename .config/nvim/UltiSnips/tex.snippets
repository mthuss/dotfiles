snippet barticle "Begin article"
\documentclass{article}
\usepackage{amsmath}
\title{$1}
\begin{document}
    $0
\end{document}
endsnippet

snippet today "Date"
`date +%F`
endsnippet

snippet beg "begin{} / end{}" bA
\begin{$1}
    $0
\end{$1}
endsnippet

snippet mk "Math" wA
$${1}$`!p
if t[2] and t[2][0] not in [',', '.', '?', '-', ' ']:
    snip.rv = ' '
else:
    snip.rv = ''
`$2
endsnippet

# make sure that snippets are only expanded on the correct contexts
global !p
def math():
    return vim.eval('vimtex#syntax#in_mathzone()') == '1'

def comment(): 
    return vim.eval('vimtex#syntax#in_comment()') == '1'

def env(name):
    [x,y] = vim.eval("vimtex#env#is_inside('" + name + "')") 
    return x != '0' and x != '0'

endglobal

snippet sec "\section{}" bA
\section{$1}
    $0
endsnippet

snippet nsec "\section*{}" bA
\section*{$1}
    $0
endsnippet

snippet ssec "\subsection{}" bA
\subsection{$1}
    $0
endsnippet

snippet upkg "\usepackage{}"
\usepackage{$1}$0
endsnippet

snippet bold "\textbf{}"
\textbf{$1}$0
endsnippet

snippet it "\textit{}"
\textit{$1}$0
endsnippet

snippet ul "\underline{}"
\underline{$1}$0
endsnippet
